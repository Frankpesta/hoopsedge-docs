{
  "name": "hoopsedge-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "types:generate": "openapi-typescript ../docs/api/openapi.json -o lib/api-types.ts",
    "types:check": "node scripts/check-types.mjs",
    "check:leak": "node scripts/check-leak.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "mock-api": "node e2e/mock-api.mjs"
  },
  "dependencies": {
    "framer-motion": "14.10.1",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "3.1.2",
    "server-only": "0.0.1",
    "swr": "2.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.29",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.9.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
